# Dependencies
node_modules/

# Production build (ADR-0031)
# dist/ izleniyordu ve izlenmeye devam ediyordu. Vite paketi VITE_* Firebase
# anahtarlarını içine gömdüğü için her derlemede üretilen paket repoya
# sızma riski taşıyordu. Artık sürüm kontrolüne girmez.
dist/

# Build cache / logs
*.log
npm-debug.log*
.vite/
.cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Yerel gizli dosyalar
.env
.env.local
.freebuff/

# Harness / clickaudit build artifacts (repoya girmez, dist/ mantigi ile ayni gerekce)
brain/scratchpad/harness/out/
brain/scratchpad/harness/*.json
brain/scratchpad/clickaudit/out/
brain/scratchpad/clickaudit/*.json

# Agent runtime state
.agents/.state/